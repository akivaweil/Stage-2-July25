{
    "workbench.iconTheme": "material-icon-theme",
    "folder-path-color.folders": [
        { "path": "src", "color": "blue", "symbol": "🏠", "tooltip": "Main source files" },
        { "path": "src/Config", "color": "green", "symbol": "⚙️", "tooltip": "Configuration files" },
        { "path": "src/StateMachine", "color": "magenta", "symbol": "🔄", "tooltip": "State machine logic" },

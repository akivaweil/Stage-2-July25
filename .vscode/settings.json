        { "path": "include", "color": "red", "symbol": "💾", "tooltip": "Header files" }
    ],
    "workbench.colorCustomizations": {
        "folderPathColor.custom1": "#0066cc",
        "folderPathColor.custom2": "#00cc33",
        "folderPathColor.custom3": "#9933ff",
